# Bu dosyayı ".env" adıyla kopyala ve doldur. .env dosyasını KİMSEYLE paylaşma.

# Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# Karia sunucusunun ID'si (sunucuya sağ tık > Sunucu ID'sini Kopyala)
GUILD_ID=

# Discord Etkinliği için: Developer Portal > OAuth2 > Client Secret
# DISCORD_CLIENT_SECRET=
# ACTIVITY_PORT=8787

# karia.live sitesi için: uzun rastgele bir anahtar. Sitenin .env dosyasındaki KARIA_LOCAL_API_SECRET ile aynı olmalı.
# Boş bırakılırsa site bağlantısı açılmaz.
# WEB_API_SECRET=
# WEB_API_PORT=8788

# Minecraft eklentisi için ayrı anahtar. Boşsa Minecraft bakiye bağlantısı kapalı kalır.
# MC_API_SECRET=

# Yapay zeka (isteğe bağlı) — Ollama adresi ve model. Boş bırakılırsa aşağıdaki varsayılanlar kullanılır.
# AI_URL=http://127.0.0.1:11434
# AI_MODEL=qwen3.5:4b

# Sosyal paylaşım (Yönetim > Sosyal Paylaşım). Anahtarlar veritabanında SOCIAL_TOKEN_KEY ile şifrelenir; sonradan değişirse hesaplar yeniden bağlanır.
# Yönlendirme adresleri: https://activity.karia.live/social/callback/{instagram|youtube|tiktok}
# SOCIAL_TOKEN_KEY=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Platform denetimi tamamlanınca 1 yap: videolar herkese açık çıkar.
# YOUTUBE_AUDITED=
# TIKTOK_AUDITED=
