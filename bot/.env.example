# Bu dosyayı ".env" adıyla kopyala ve doldur. .env dosyasını KİMSEYLE paylaşma.

# Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# Karia sunucusunun ID'si (sunucuya sağ tık > Sunucu ID'sini Kopyala)
GUILD_ID=

# Discord Etkinliği için: Developer Portal > OAuth2 > Client Secret
# DISCORD_CLIENT_SECRET=
# ACTIVITY_PORT=8787

# karia.live sitesi için: uzun rastgele bir anahtar. Sitenin .env dosyasındaki KARIA_LOCAL_API_SECRET ile aynı olmalı.
# Boş bırakılırsa site bağlantısı açılmaz.
# WEB_API_SECRET=
# WEB_API_PORT=8788

# Minecraft eklentisi için ayrı anahtar. Boşsa Minecraft bakiye bağlantısı kapalı kalır.
# MC_API_SECRET=

# Yapay zeka (isteğe bağlı) — Ollama adresi ve model. Boş bırakılırsa aşağıdaki varsayılanlar kullanılır.
# AI_URL=http://127.0.0.1:11434
# AI_MODEL=qwen3.5:4b

# Sosyal paylaşım (Yönetim > Sosyal Paylaşım). Anahtarlar veritabanında SOCIAL_TOKEN_KEY ile şifrelenir; sonradan değişirse hesaplar yeniden bağlanır.
# Yönlendirme adresleri: https://activity.karia.live/social/callback/{instagram|youtube|tiktok}
# SOCIAL_TOKEN_KEY=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# Meta > Instagram API > API setup with Unified login yapılandırmasının kimliği
# INSTAGRAM_CONFIG_ID=
# Meta hesabı listelemezse kullanılacak Instagram hesap kimliği (Business Suite > Instagram profilleri)
# INSTAGRAM_ACCOUNT_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Platform denetimi tamamlanınca 1 yap: videolar herkese açık çıkar.
# YOUTUBE_AUDITED=
# TIKTOK_AUDITED=

# Müzik hesabı bağlama (Etkinlik > Müzik > Aktar). Anahtarlar SOCIAL_TOKEN_KEY ile şifrelenir.
# Yönlendirme adresleri: https://activity.karia.live/music/callback/{spotify|youtube}
# YouTube Music yukarıdaki GOOGLE_CLIENT_ID/SECRET'ı kullanır; Google Console'a yönlendirme adresini ekle.
# Spotify: developer.spotify.com > Dashboard. Geliştirme modunda sadece "User Management"a eklenen 5 hesap bağlanabilir.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Etkinlikte bot olmadan çalınan şarkıların disk önbelleği (MB, varsayılan 1024)
# MUSIC_CACHE_MB=
# Ses kanalı müziği için Lavalink (bot/lavalink/README.md). Boş bırakılırsa ya da Lavalink'e ulaşılamazsa
# müzik eski yolla (yt-dlp + ffmpeg) çalar, filtreler kapalı olur. Şifre uzun ve rastgele olmalı;
# Lavalink de aynı şifreyi bu dosyadan okur (ecosystem.config.cjs).
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=
# YouTube sunucuyu engellerse Lavalink'in OAuth yenileme anahtarı (isteğe bağlı, README'ye bak)
# LAVALINK_YT_REFRESH_TOKEN=
