{
  "name": "karia-bot",
  "version": "0.1.0",
  "description": "Karia Discord sunucusuna özel bot",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --watch --env-file=.env --disable-warning=ExperimentalWarning src/index.js",
    "check": "node --disable-warning=ExperimentalWarning src/check.js",
    "activity:build": "esbuild src/activity/client/sdk-entry.js --bundle --format=esm --minify --outfile=src/activity/public/sdk.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^1.0.12",
    "adm-zip": "^0.6.1",
    "discord.js": "^14.28.1",
    "ffmpeg-static": "^5.3.0",
    "minecraft-server-util": "^5.4.4",
    "youtube-dl-exec": "^3.1.19"
  },
  "devDependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "esbuild": "^0.28.2"
  }
}
